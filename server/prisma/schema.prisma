generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProductAvailability {
  IN_STOCK
  OUT_OF_STOCK
  ON_REQUEST
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
}

model Admin {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(ADMIN)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([isActive])
}

model Category {
  id                 String    @id @default(cuid())
  name               String
  slug               String    @unique
  description        String?
  coverImageUrl      String?
  coverImagePublicId String?
  isActive           Boolean   @default(true)
  displayOrder       Int       @default(0)
  products           Product[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([isActive])
  @@index([displayOrder])
}

model Product {
  id           String              @id @default(cuid())
  categoryId   String
  name         String?
  slug         String              @unique
  availability ProductAvailability @default(ON_REQUEST)
  isPublished  Boolean             @default(true)
  isFeatured   Boolean             @default(false)
  displayOrder Int                 @default(0)

  category  Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  images    ProductImage[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([categoryId])
  @@index([isPublished])
  @@index([isFeatured])
  @@index([displayOrder])
}

model ProductImage {
  id           String   @id @default(cuid())
  productId    String
  url          String
  publicId     String
  altText      String?
  isPrimary    Boolean  @default(false)
  displayOrder Int      @default(0)

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([isPrimary])
}

model GalleryImage {
  id           String   @id @default(cuid())
  url          String
  publicId     String
  title        String?
  description  String?
  altText      String?
  isPublished  Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isPublished])
  @@index([displayOrder])
}

model SiteSetting {
  id             String   @id @default("site")
  businessName   String
  slogan         String?
  description    String?
  phone          String?
  secondaryPhone String?
  whatsapp       String?
  email          String?
  address        String?
  city           String?
  state          String?
  country        String?
  openingHours   String?
  logoUrl        String?
  faviconUrl     String?
  instagramUrl   String?
  facebookUrl    String?
  tiktokUrl      String?
  linkedinUrl    String?
  youtubeUrl     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}